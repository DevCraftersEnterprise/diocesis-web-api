# --- Entorno de ejecucion ---
# Stack NestJS (ADR-003). NODE_ENV controla el modo del framework.
NODE_ENV=development
# Puerto local. En Render/produccion el host inyecta PORT.
PORT=3000

# --- Base de datos ---
# Paridad con Django: config/settings.py usa DATABASE_URL (dj-database-url)
# apuntando a PostgreSQL. Formato: postgresql://user:pass@host:puerto/db
DATABASE_URL=
# Postgres gestionado suele exigir SSL; en local normalmente no.
DATABASE_SSL=false

# --- Autenticacion JWT ---
# Secreto de firma HS256 (ADR-002). En Django lo cumple SECRET_KEY.
# Si en el corte se aceptan tokens ya emitidos debe COINCIDIR con el
# SECRET_KEY de Django; si el corte es duro (re-login) puede ser nuevo.
JWT_SECRET=
# Vidas de token: espejo de Django SIMPLE_JWT (access 8h, refresh 1d).
# Formato revisable en ADR-002.
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=1d

# --- Cloudinary ---
# Paridad con Django CLOUDINARY_STORAGE (subida de imagenes/videos/docs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
# Django hoy usa CORS_ALLOW_ALL_ORIGINS=True. Decidido restringir a una
# allowlist (SECURITY-003, Fase 1.9). Origenes del frontend separados por
# comas, p. ej.: http://localhost:4200,https://<dominio-prod>
CORS_ORIGINS=

# --- Logging ---
# Nivel de pino (Tarea 1.7): fatal|error|warn|info|debug|trace|silent. Default info.
LOG_LEVEL=info