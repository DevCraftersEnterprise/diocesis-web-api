NODE_ENV=test
PORT=3001

# Desde la Tarea 1.2 el AppModule importa DatabaseModule, asi que los tests e2e
# conectan de verdad: apuntan al contenedor oraculo (docs/oracle/docker-compose.yml).
# Levantarlo antes de `npm run test:e2e`:  docker compose -f docs/oracle/docker-compose.yml up -d
DATABASE_URL=postgres://oracle:oracle@127.0.0.1:5433/diocesis_oracle
DATABASE_SSL=false

JWT_SECRET=test-secret-solo-para-tests-0123456789
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=1d

CORS_ORIGINS=http://localhost:4200
